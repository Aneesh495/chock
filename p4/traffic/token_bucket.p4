/*
 * Hierarchical Token Bucket Policer (trTCM RFC 2698) (P4_16)
 *
 * Implements Two-Rate Three-Color Marker (trTCM) policing:
 * Meters packets against Committed Information Rate (CIR), Committed Burst Size (CBS),
 * Peak Information Rate (PIR), and Peak Burst Size (PBS).
 */

#ifndef _CHOCK_TRAFFIC_TOKEN_BUCKET_P4_
#define _CHOCK_TRAFFIC_TOKEN_BUCKET_P4_

#include "../arch/chock_arch.p4"
#include "../core/types.p4"
#include "../core/unified_headers.p4"
#include "../core/metadata.p4"

control ChockTokenBucketPolicer(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    ChockMeter(4096) trtcm_meter;

    action apply_traffic_policing(bit<32> meter_idx) {
        MeterColor_t color = trtcm_meter.execute(meter_idx, (bit<32>)ig_intr_md.packet_length_bytes);
        user_meta.traffic_meta.meter_result_color = color;

        if (color == MeterColor_t.COLOR_RED) {
            ig_to_eg_md.drop_flag = 1#1;
            ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_DROP;
        } else if (color == MeterColor_t.COLOR_YELLOW) {
            /* Demote DSCP on yellow packets */
            hdr.ipv4.dscp = DSCP_AF12;
        }
    }

    table traffic_policer_table {
        key = {
            ig_intr_md.ingress_port:  exact;
            hdr.ipv4.dscp:            ternary;
        }
        actions = {
            apply_traffic_policing;
            NoAction;
        }
        size = 4096;
        default_action = NoAction();
    }

    apply {
        if (hdr.ipv4.isValid()) {
            traffic_policer_table.apply();
        }
    }
}


/*
 * Comprehensive Match-Action Processing Pipeline for TokenBucketEngine
 * Implements hardware TCAM, SRAM, and stateful ALU execution stages.
 */

control ChockTokenBucketEngineStage0(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    ChockRegister<bit<32>>(2048, 0) stage_state_reg;
    ChockCounter(2048, CounterType_t.PACKETS_AND_BYTES) stage_counter;
    ChockMeter(2048) stage_meter;

    action execute_tokenbucketengine_stage0_act0(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_tokenbucketengine_stage0_act1(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_tokenbucketengine_stage0_act2(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_tokenbucketengine_stage0_act3(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action drop_tokenbucketengine_stage0(bit<8> drop_code) {
        ig_to_eg_md.drop_flag = 1#1;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_DROP;
    }

    table tokenbucketengine_stage0_table {
        key = {
            ig_intr_md.ingress_port:           exact;
            user_meta.l2_meta.ingress_vlan_id: ternary;
            hdr.ipv4.dst_addr:                 ternary;
            hdr.ipv4.src_addr:                 ternary;
            hdr.ipv4.protocol:                 ternary;
            user_meta.parser_meta.l4_src_port: ternary;
            user_meta.parser_meta.l4_dst_port: ternary;
        }
        actions = {
            execute_tokenbucketengine_stage0_act0;
            execute_tokenbucketengine_stage0_act1;
            execute_tokenbucketengine_stage0_act2;
            execute_tokenbucketengine_stage0_act3;
            drop_tokenbucketengine_stage0;
            NoAction;
        }
        size = 2048;
        default_action = NoAction();
    }

    apply {
        tokenbucketengine_stage0_table.apply();
    }
}

