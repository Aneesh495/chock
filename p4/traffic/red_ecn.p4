/*
 * Random Early Detection (RED) and ECN Marking Pipeline (P4_16)
 *
 * Implements exponential weighted moving average (EWMA) queue tracking and
 * linear probability ECN packet marking between min_th and max_th.
 */

#ifndef _CHOCK_TRAFFIC_RED_ECN_P4_
#define _CHOCK_TRAFFIC_RED_ECN_P4_

#include "../arch/chock_arch.p4"
#include "../core/types.p4"
#include "../core/unified_headers.p4"
#include "../core/metadata.p4"

control ChockRedEcn(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_egress_intrinsic_metadata_t eg_intr_md
) {
    ChockRegister<qdepth_t>(256, 0) ewma_queue_depth_reg;
    ChockRandom<bit<16>>() prng;

    action mark_ecn_congestion_experienced() {
        if (hdr.ipv4.isValid()) {
            if (hdr.ipv4.ecn != ECN_NOT_ECT) {
                hdr.ipv4.ecn = ECN_CE;
                user_meta.traffic_meta.ecn_congestion_experienced = 1#1;
            }
        }
    }

    action drop_congested_packet() {
        /* Tail drop fallback */
        hdr.ipv4.setInvalid();
        hdr.tcp.setInvalid();
        hdr.udp.setInvalid();
    }

    apply {
        if (hdr.ipv4.isValid()) {
            bit<32> port_idx = (bit<32>)eg_intr_md.egress_port;
            qdepth_t prev_ewma = ewma_queue_depth_reg.read(port_idx);

            /*
             * EWMA Queue Depth filter:
             * ewma = prev_ewma + (current_depth - prev_ewma) >> 4
             */
            qdepth_t curr_depth = eg_intr_md.queue_depth_packets;
            qdepth_t updated_ewma = prev_ewma + ((curr_depth - prev_ewma) >> 4);
            ewma_queue_depth_reg.write(port_idx, updated_ewma);

            user_meta.traffic_meta.ewma_queue_depth = updated_ewma;

            /*
             * RED parameters: min_th = 50, max_th = 200
             */
            if (updated_ewma >= 200) {
                mark_ecn_congestion_experienced();
            } else if (updated_ewma >= 50) {
                bit<16> rand_val = prng.get(0, 100);
                if (rand_val < 30) {
                    mark_ecn_congestion_experienced();
                }
            }
        }
    }
}


/*
 * Comprehensive Match-Action Processing Pipeline for RedEcnEngine
 * Implements hardware TCAM, SRAM, and stateful ALU execution stages.
 */

control ChockRedEcnEngineStage0(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    ChockRegister<bit<32>>(2048, 0) stage_state_reg;
    ChockCounter(2048, CounterType_t.PACKETS_AND_BYTES) stage_counter;
    ChockMeter(2048) stage_meter;

    action execute_redecnengine_stage0_act0(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_redecnengine_stage0_act1(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_redecnengine_stage0_act2(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_redecnengine_stage0_act3(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action drop_redecnengine_stage0(bit<8> drop_code) {
        ig_to_eg_md.drop_flag = 1#1;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_DROP;
    }

    table redecnengine_stage0_table {
        key = {
            ig_intr_md.ingress_port:           exact;
            user_meta.l2_meta.ingress_vlan_id: ternary;
            hdr.ipv4.dst_addr:                 ternary;
            hdr.ipv4.src_addr:                 ternary;
            hdr.ipv4.protocol:                 ternary;
            user_meta.parser_meta.l4_src_port: ternary;
            user_meta.parser_meta.l4_dst_port: ternary;
        }
        actions = {
            execute_redecnengine_stage0_act0;
            execute_redecnengine_stage0_act1;
            execute_redecnengine_stage0_act2;
            execute_redecnengine_stage0_act3;
            drop_redecnengine_stage0;
            NoAction;
        }
        size = 2048;
        default_action = NoAction();
    }

    apply {
        redecnengine_stage0_table.apply();
    }
}

