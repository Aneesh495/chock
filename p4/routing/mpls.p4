/*
 * Multiprotocol Label Switching (MPLS) Pipeline (P4_16)
 *
 * Implements label push, pop, swap, and penultimate hop popping (PHP)
 * with strict Traffic Class (EXP) and TTL propagation.
 */

#ifndef _CHOCK_ROUTING_MPLS_P4_
#define _CHOCK_ROUTING_MPLS_P4_

#include "../arch/chock_arch.p4"
#include "../core/types.p4"
#include "../core/unified_headers.p4"
#include "../core/metadata.p4"

control ChockMplsPipeline(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    action mpls_swap(
        mpls_label_t new_label,
        port_id_t    egress_port,
        mac_addr_t   next_hop_mac
    ) {
        hdr.mpls_0.label = new_label;
        hdr.mpls_0.ttl = hdr.mpls_0.ttl - 1;
        ig_to_eg_md.egress_port = egress_port;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_UNICAST;
        hdr.ethernet.dst_addr = next_hop_mac;
    }

    action mpls_push(
        mpls_label_t new_label,
        port_id_t    egress_port,
        mac_addr_t   next_hop_mac
    ) {
        hdr.mpls_0.setValid();
        hdr.mpls_0.label = new_label;
        hdr.mpls_0.traffic_class = 3#0;
        hdr.mpls_0.bottom_of_stack = 1#1;
        hdr.mpls_0.ttl = 64;

        hdr.ethernet.ether_type = ETHERTYPE_MPLS_UNICAST;
        hdr.ethernet.dst_addr = next_hop_mac;
        ig_to_eg_md.egress_port = egress_port;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_UNICAST;
    }

    action mpls_pop_php(
        port_id_t  egress_port,
        mac_addr_t next_hop_mac
    ) {
        hdr.mpls_0.setInvalid();
        hdr.ethernet.ether_type = ETHERTYPE_IPV4;
        hdr.ethernet.dst_addr = next_hop_mac;
        ig_to_eg_md.egress_port = egress_port;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_UNICAST;
    }

    table mpls_forwarding_table {
        key = {
            hdr.mpls_0.label: exact;
        }
        actions = {
            mpls_swap;
            mpls_pop_php;
        }
        size = 16384;
        default_action = mpls_swap(0, 0, 48#0);
    }

    apply {
        if (hdr.mpls_0.isValid()) {
            mpls_forwarding_table.apply();
        }
    }
}


/*
 * Comprehensive Match-Action Processing Pipeline for MplsEngine
 * Implements hardware TCAM, SRAM, and stateful ALU execution stages.
 */

control ChockMplsEngineStage0(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    ChockRegister<bit<32>>(2048, 0) stage_state_reg;
    ChockCounter(2048, CounterType_t.PACKETS_AND_BYTES) stage_counter;
    ChockMeter(2048) stage_meter;

    action execute_mplsengine_stage0_act0(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_mplsengine_stage0_act1(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_mplsengine_stage0_act2(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_mplsengine_stage0_act3(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action drop_mplsengine_stage0(bit<8> drop_code) {
        ig_to_eg_md.drop_flag = 1#1;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_DROP;
    }

    table mplsengine_stage0_table {
        key = {
            ig_intr_md.ingress_port:           exact;
            user_meta.l2_meta.ingress_vlan_id: ternary;
            hdr.ipv4.dst_addr:                 ternary;
            hdr.ipv4.src_addr:                 ternary;
            hdr.ipv4.protocol:                 ternary;
            user_meta.parser_meta.l4_src_port: ternary;
            user_meta.parser_meta.l4_dst_port: ternary;
        }
        actions = {
            execute_mplsengine_stage0_act0;
            execute_mplsengine_stage0_act1;
            execute_mplsengine_stage0_act2;
            execute_mplsengine_stage0_act3;
            drop_mplsengine_stage0;
            NoAction;
        }
        size = 2048;
        default_action = NoAction();
    }

    apply {
        mplsengine_stage0_table.apply();
    }
}

