/*
 * Segment Routing over IPv6 (SRv6) End.X Cross-Connect Behavior (P4_16)
 *
 * Implements standard SRv6 End.X function (RFC 8986 Section 4.2):
 * Decrements Segments Left pointer, updates destination address, and directly
 * forwards packet to the assigned Layer 3 adjacency.
 */

#ifndef _CHOCK_ROUTING_SRV6_END_X_P4_
#define _CHOCK_ROUTING_SRV6_END_X_P4_

#include "../arch/chock_arch.p4"
#include "../core/types.p4"
#include "../core/unified_headers.p4"
#include "../core/metadata.p4"

control ChockSrv6EndX(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    action cross_connect_adjacency(
        port_id_t  target_port,
        mac_addr_t next_hop_mac,
        mac_addr_t router_mac
    ) {
        if (hdr.srv6_srh.segments_left > 0) {
            hdr.srv6_srh.segments_left = hdr.srv6_srh.segments_left - 1;
            user_meta.srv6_meta.segments_left = hdr.srv6_srh.segments_left;

            if (hdr.srv6_srh.segments_left == 0) {
                hdr.ipv6.dst_addr = hdr.srv6_seg0.sid;
            } else if (hdr.srv6_srh.segments_left == 1) {
                hdr.ipv6.dst_addr = hdr.srv6_seg1.sid;
            } else if (hdr.srv6_srh.segments_left == 2) {
                hdr.ipv6.dst_addr = hdr.srv6_seg2.sid;
            }
        }

        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_UNICAST;

        hdr.ethernet.src_addr = router_mac;
        hdr.ethernet.dst_addr = next_hop_mac;
    }

    table srv6_end_x_table {
        key = {
            hdr.ipv6.dst_addr: exact;
        }
        actions = {
            cross_connect_adjacency;
        }
        size = 4096;
        default_action = cross_connect_adjacency(0, 48#0, 48#0);
    }

    apply {
        if (hdr.srv6_srh.isValid()) {
            srv6_end_x_table.apply();
        }
    }
}


/*
 * Comprehensive Match-Action Processing Pipeline for Srv6EndXEngine
 * Implements hardware TCAM, SRAM, and stateful ALU execution stages.
 */

control ChockSrv6EndXEngineStage0(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    ChockRegister<bit<32>>(2048, 0) stage_state_reg;
    ChockCounter(2048, CounterType_t.PACKETS_AND_BYTES) stage_counter;
    ChockMeter(2048) stage_meter;

    action execute_srv6endxengine_stage0_act0(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_srv6endxengine_stage0_act1(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_srv6endxengine_stage0_act2(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_srv6endxengine_stage0_act3(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action drop_srv6endxengine_stage0(bit<8> drop_code) {
        ig_to_eg_md.drop_flag = 1#1;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_DROP;
    }

    table srv6endxengine_stage0_table {
        key = {
            ig_intr_md.ingress_port:           exact;
            user_meta.l2_meta.ingress_vlan_id: ternary;
            hdr.ipv4.dst_addr:                 ternary;
            hdr.ipv4.src_addr:                 ternary;
            hdr.ipv4.protocol:                 ternary;
            user_meta.parser_meta.l4_src_port: ternary;
            user_meta.parser_meta.l4_dst_port: ternary;
        }
        actions = {
            execute_srv6endxengine_stage0_act0;
            execute_srv6endxengine_stage0_act1;
            execute_srv6endxengine_stage0_act2;
            execute_srv6endxengine_stage0_act3;
            drop_srv6endxengine_stage0;
            NoAction;
        }
        size = 2048;
        default_action = NoAction();
    }

    apply {
        srv6endxengine_stage0_table.apply();
    }
}

