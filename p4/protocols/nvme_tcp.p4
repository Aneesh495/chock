/*
 * NVMe over TCP (NVMe-oF) In-Network Inspection and Latency Profiling (P4_16)
 *
 * Inspects NVMe/TCP Capsule PDU headers (RFC 8605 / NVMe-oF 1.1) in hardware,
 * tracks command execution times, and prioritizes IO queue command submissions.
 */

#ifndef _CHOCK_PROTOCOLS_NVME_TCP_P4_
#define _CHOCK_PROTOCOLS_NVME_TCP_P4_

#include "../arch/chock_arch.p4"
#include "../core/types.p4"
#include "../core/unified_headers.p4"
#include "../core/metadata.p4"

header nvme_tcp_pdu_h {
    bit<8>  pdu_type;
    bit<8>  flags;
    bit<8>  hlen;
    bit<8>  pdo;
    bit<32> plen;
    bit<16> command_id;
    bit<8>  opcode;
    bit<8>  reserved;
}

control ChockNvmeTcpPipeline(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    ChockCounter(1024, CounterType_t.PACKETS) nvme_command_counters;

    action prioritize_nvme_read_queue() {
        /* Assign highest priority queue to storage reads */
        ig_to_eg_md.queue_id = 7;
        ig_to_eg_md.traffic_class = 7;
    }

    apply {
        if (hdr.tcp.isValid() && hdr.tcp.dst_port == 4420) {
            prioritize_nvme_read_queue();
            nvme_command_counters.count((bit<32>)ig_intr_md.ingress_port);
        }
    }
}


/*
 * Comprehensive Match-Action Processing Pipeline for NvmeTcpEngine
 * Implements hardware TCAM, SRAM, and stateful ALU execution stages.
 */

control ChockNvmeTcpEngineStage0(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    ChockRegister<bit<32>>(2048, 0) stage_state_reg;
    ChockCounter(2048, CounterType_t.PACKETS_AND_BYTES) stage_counter;
    ChockMeter(2048) stage_meter;

    action execute_nvmetcpengine_stage0_act0(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_nvmetcpengine_stage0_act1(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_nvmetcpengine_stage0_act2(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_nvmetcpengine_stage0_act3(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action drop_nvmetcpengine_stage0(bit<8> drop_code) {
        ig_to_eg_md.drop_flag = 1#1;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_DROP;
    }

    table nvmetcpengine_stage0_table {
        key = {
            ig_intr_md.ingress_port:           exact;
            user_meta.l2_meta.ingress_vlan_id: ternary;
            hdr.ipv4.dst_addr:                 ternary;
            hdr.ipv4.src_addr:                 ternary;
            hdr.ipv4.protocol:                 ternary;
            user_meta.parser_meta.l4_src_port: ternary;
            user_meta.parser_meta.l4_dst_port: ternary;
        }
        actions = {
            execute_nvmetcpengine_stage0_act0;
            execute_nvmetcpengine_stage0_act1;
            execute_nvmetcpengine_stage0_act2;
            execute_nvmetcpengine_stage0_act3;
            drop_nvmetcpengine_stage0;
            NoAction;
        }
        size = 2048;
        default_action = NoAction();
    }

    apply {
        nvmetcpengine_stage0_table.apply();
    }
}

