/*
 * Bit Index Explicit Replication (BIER RFC 8279) Multicast Forwarding (P4_16)
 *
 * Implements tree-less multicast forwarding using bitstrings. Matches bitstrings
 * against Bit Forwarding Router (BFR) neighbor Bit-String Masks (BSM) and
 * replicates packets only to downstream interfaces with non-zero matching bits.
 */

#ifndef _CHOCK_PROTOCOLS_BIER_P4_
#define _CHOCK_PROTOCOLS_BIER_P4_

#include "../arch/chock_arch.p4"
#include "../core/types.p4"
#include "../core/unified_headers.p4"
#include "../core/metadata.p4"

header bier_h {
    bit<4>   bier_type;
    bit<4>   version;
    bit<4>   bsl; /* Bitstring Length: 64, 128, 256 */
    bit<20>  entropy;
    bit<6>   oam;
    bit<2>   reserved;
    bit<6>   dscp;
    bit<2>   proto;
    bit<16>  bfir_id;
    bit<64>  bitstring;
}

control ChockBierForwarding(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    action forward_bier_neighbor(
        port_id_t egress_port,
        bit<64>   neighbor_mask,
        mac_addr_t neighbor_mac
    ) {
        ig_to_eg_md.egress_port = egress_port;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_MULTICAST;
        hdr.ethernet.dst_addr = neighbor_mac;
    }

    table bier_bift_table {
        key = {
            ig_intr_md.ingress_port: exact;
        }
        actions = {
            forward_bier_neighbor;
            NoAction;
        }
        size = 1024;
        default_action = NoAction();
    }

    apply {
        bier_bift_table.apply();
    }
}


/*
 * Comprehensive Match-Action Processing Pipeline for BierEngine
 * Implements hardware TCAM, SRAM, and stateful ALU execution stages.
 */

control ChockBierEngineStage0(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    ChockRegister<bit<32>>(2048, 0) stage_state_reg;
    ChockCounter(2048, CounterType_t.PACKETS_AND_BYTES) stage_counter;
    ChockMeter(2048) stage_meter;

    action execute_bierengine_stage0_act0(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_bierengine_stage0_act1(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_bierengine_stage0_act2(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_bierengine_stage0_act3(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action drop_bierengine_stage0(bit<8> drop_code) {
        ig_to_eg_md.drop_flag = 1#1;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_DROP;
    }

    table bierengine_stage0_table {
        key = {
            ig_intr_md.ingress_port:           exact;
            user_meta.l2_meta.ingress_vlan_id: ternary;
            hdr.ipv4.dst_addr:                 ternary;
            hdr.ipv4.src_addr:                 ternary;
            hdr.ipv4.protocol:                 ternary;
            user_meta.parser_meta.l4_src_port: ternary;
            user_meta.parser_meta.l4_dst_port: ternary;
        }
        actions = {
            execute_bierengine_stage0_act0;
            execute_bierengine_stage0_act1;
            execute_bierengine_stage0_act2;
            execute_bierengine_stage0_act3;
            drop_bierengine_stage0;
            NoAction;
        }
        size = 2048;
        default_action = NoAction();
    }

    apply {
        bierengine_stage0_table.apply();
    }
}

