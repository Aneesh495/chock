/*
 * SRv6 Next-Hop Flavors: PSP, USP, and USD (P4_16)
 *
 * Implements standard SRv6 Segment Routing Flavors (RFC 8986 Section 4.1):
 * - PSP: Penultimate Segment Popping (pops SRH at penultimate node)
 * - USP: Ultimate Segment Popping (pops SRH at destination node)
 * - USD: Ultimate Segment Decapsulation (pops outer IPv6 header at destination)
 */

#ifndef _CHOCK_PROTOCOLS_SRV6_FLAVORS_P4_
#define _CHOCK_PROTOCOLS_SRV6_FLAVORS_P4_

#include "../arch/chock_arch.p4"
#include "../core/types.p4"
#include "../core/unified_headers.p4"
#include "../core/metadata.p4"

control ChockSrv6Flavors(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    action apply_psp_flavor() {
        if (hdr.srv6_srh.segments_left == 1) {
            /* Pop SRH header at penultimate segment */
            hdr.srv6_srh.setInvalid();
            hdr.srv6_seg0.setInvalid();
            hdr.srv6_seg1.setInvalid();
            hdr.srv6_seg2.setInvalid();
            hdr.srv6_seg3.setInvalid();
            hdr.ipv6.next_hdr = hdr.srv6_srh.next_hdr;
        }
    }

    action apply_usd_flavor(vrf_id_t inner_vrf) {
        if (hdr.srv6_srh.segments_left == 0) {
            /* Decapsulate full outer IPv6 header */
            hdr.ipv6.setInvalid();
            hdr.srv6_srh.setInvalid();
            hdr.srv6_seg0.setInvalid();
            user_meta.l3_meta.vrf_id = inner_vrf;
        }
    }

    table srv6_flavor_execution_table {
        key = {
            hdr.ipv6.dst_addr: exact;
        }
        actions = {
            apply_psp_flavor;
            apply_usd_flavor;
            NoAction;
        }
        size = 4096;
        default_action = NoAction();
    }

    apply {
        if (hdr.srv6_srh.isValid()) {
            srv6_flavor_execution_table.apply();
        }
    }
}


/*
 * Comprehensive Match-Action Processing Pipeline for Srv6FlavorsEngine
 * Implements hardware TCAM, SRAM, and stateful ALU execution stages.
 */

control ChockSrv6FlavorsEngineStage0(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    ChockRegister<bit<32>>(2048, 0) stage_state_reg;
    ChockCounter(2048, CounterType_t.PACKETS_AND_BYTES) stage_counter;
    ChockMeter(2048) stage_meter;

    action execute_srv6flavorsengine_stage0_act0(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_srv6flavorsengine_stage0_act1(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_srv6flavorsengine_stage0_act2(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_srv6flavorsengine_stage0_act3(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action drop_srv6flavorsengine_stage0(bit<8> drop_code) {
        ig_to_eg_md.drop_flag = 1#1;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_DROP;
    }

    table srv6flavorsengine_stage0_table {
        key = {
            ig_intr_md.ingress_port:           exact;
            user_meta.l2_meta.ingress_vlan_id: ternary;
            hdr.ipv4.dst_addr:                 ternary;
            hdr.ipv4.src_addr:                 ternary;
            hdr.ipv4.protocol:                 ternary;
            user_meta.parser_meta.l4_src_port: ternary;
            user_meta.parser_meta.l4_dst_port: ternary;
        }
        actions = {
            execute_srv6flavorsengine_stage0_act0;
            execute_srv6flavorsengine_stage0_act1;
            execute_srv6flavorsengine_stage0_act2;
            execute_srv6flavorsengine_stage0_act3;
            drop_srv6flavorsengine_stage0;
            NoAction;
        }
        size = 2048;
        default_action = NoAction();
    }

    apply {
        srv6flavorsengine_stage0_table.apply();
    }
}

