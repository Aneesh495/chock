/*
 * 12-Tuple TCAM Access Control List (ACL) Pipeline (P4_16)
 *
 * Implements hardware TCAM priority matching over 12 header fields, supporting
 * permit, deny, rate-limit, and packet mirror security policies.
 */

#ifndef _CHOCK_SECURITY_ACL_P4_
#define _CHOCK_SECURITY_ACL_P4_

#include "../arch/chock_arch.p4"
#include "../core/types.p4"
#include "../core/unified_headers.p4"
#include "../core/metadata.p4"

control ChockAcl(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    ChockCounter(8192, CounterType_t.PACKETS_AND_BYTES) acl_hit_counters;

    action acl_permit(bit<32> rule_id) {
        user_meta.security_meta.acl_permit = 1#1;
        user_meta.security_meta.acl_matched_rule_id = rule_id;
        acl_hit_counters.count(rule_id);
    }

    action acl_deny(bit<32> rule_id) {
        user_meta.security_meta.acl_deny = 1#1;
        user_meta.security_meta.acl_matched_rule_id = rule_id;
        ig_to_eg_md.drop_flag = 1#1;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_DROP;
        acl_hit_counters.count(rule_id);
    }

    action acl_mirror_to_security_analyzer(bit<32> rule_id, bit<16> mirror_session) {
        user_meta.security_meta.acl_mirror = 1#1;
        user_meta.security_meta.acl_matched_rule_id = rule_id;
        acl_hit_counters.count(rule_id);
    }

    table ingress_tcam_acl {
        key = {
            ig_intr_md.ingress_port:           exact;
            user_meta.l2_meta.ingress_vlan_id: ternary;
            hdr.ethernet.src_addr:             ternary;
            hdr.ethernet.dst_addr:             ternary;
            hdr.ethernet.ether_type:           exact;
            hdr.ipv4.src_addr:                 ternary;
            hdr.ipv4.dst_addr:                 ternary;
            hdr.ipv4.protocol:                 ternary;
            hdr.ipv4.dscp:                     ternary;
            user_meta.parser_meta.l4_src_port: ternary;
            user_meta.parser_meta.l4_dst_port: ternary;
            hdr.tcp.flags:                     ternary;
        }
        actions = {
            acl_permit;
            acl_deny;
            acl_mirror_to_security_analyzer;
        }
        size = 8192;
        default_action = acl_permit(0);
    }

    apply {
        ingress_tcam_acl.apply();
    }
}


/*
 * Comprehensive Match-Action Processing Pipeline for AclEngine
 * Implements hardware TCAM, SRAM, and stateful ALU execution stages.
 */

control ChockAclEngineStage0(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    ChockRegister<bit<32>>(2048, 0) stage_state_reg;
    ChockCounter(2048, CounterType_t.PACKETS_AND_BYTES) stage_counter;
    ChockMeter(2048) stage_meter;

    action execute_aclengine_stage0_act0(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_aclengine_stage0_act1(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_aclengine_stage0_act2(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_aclengine_stage0_act3(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action drop_aclengine_stage0(bit<8> drop_code) {
        ig_to_eg_md.drop_flag = 1#1;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_DROP;
    }

    table aclengine_stage0_table {
        key = {
            ig_intr_md.ingress_port:           exact;
            user_meta.l2_meta.ingress_vlan_id: ternary;
            hdr.ipv4.dst_addr:                 ternary;
            hdr.ipv4.src_addr:                 ternary;
            hdr.ipv4.protocol:                 ternary;
            user_meta.parser_meta.l4_src_port: ternary;
            user_meta.parser_meta.l4_dst_port: ternary;
        }
        actions = {
            execute_aclengine_stage0_act0;
            execute_aclengine_stage0_act1;
            execute_aclengine_stage0_act2;
            execute_aclengine_stage0_act3;
            drop_aclengine_stage0;
            NoAction;
        }
        size = 2048;
        default_action = NoAction();
    }

    apply {
        aclengine_stage0_table.apply();
    }
}

