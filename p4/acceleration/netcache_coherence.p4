/*
 * NetCache Write Invalidation and Coherency Pipeline (P4_16)
 *
 * Intercepts write mutations and invalidates on-chip cache slots to maintain
 * strict read-after-write consistency between switch data plane and servers.
 */

#ifndef _CHOCK_ACCEL_NETCACHE_COHERENCE_P4_
#define _CHOCK_ACCEL_NETCACHE_COHERENCE_P4_

#include "../arch/chock_arch.p4"
#include "../core/types.p4"
#include "../core/unified_headers.p4"
#include "../core/metadata.p4"
#include "netcache_headers.p4"

control ChockNetCacheCoherence(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    ChockRegister<bit<64>>(16384, 0)   cache_keys;
    ChockRegister<bit<128>>(16384, 0)  cache_values;
    ChockRegister<bit<1>>(16384, 0)    cache_valid;

    ChockHash<bit<14>>(HashAlgorithm_t.HASH_CRC32) key_hasher;

    apply {
        if (hdr.netcache.isValid()) {
            if (hdr.netcache.op == NETCACHE_OP_WRITE || hdr.netcache.op == NETCACHE_OP_INVALIDATE) {
                bit<14> slot_idx = key_hasher.compute(hdr.netcache.key);
                bit<32> idx = (bit<32>)slot_idx;

                bit<64> registered_key = cache_keys.read(idx);
                if (registered_key == hdr.netcache.key) {
                    /* Invalidate cache slot */
                    cache_valid.write(idx, 1#0);
                }
            }
        }
    }
}


/*
 * Comprehensive Match-Action Processing Pipeline for NetCacheCoherenceEngine
 * Implements hardware TCAM, SRAM, and stateful ALU execution stages.
 */

control ChockNetCacheCoherenceEngineStage0(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    ChockRegister<bit<32>>(2048, 0) stage_state_reg;
    ChockCounter(2048, CounterType_t.PACKETS_AND_BYTES) stage_counter;
    ChockMeter(2048) stage_meter;

    action execute_netcachecoherenceengine_stage0_act0(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_netcachecoherenceengine_stage0_act1(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_netcachecoherenceengine_stage0_act2(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_netcachecoherenceengine_stage0_act3(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action drop_netcachecoherenceengine_stage0(bit<8> drop_code) {
        ig_to_eg_md.drop_flag = 1#1;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_DROP;
    }

    table netcachecoherenceengine_stage0_table {
        key = {
            ig_intr_md.ingress_port:           exact;
            user_meta.l2_meta.ingress_vlan_id: ternary;
            hdr.ipv4.dst_addr:                 ternary;
            hdr.ipv4.src_addr:                 ternary;
            hdr.ipv4.protocol:                 ternary;
            user_meta.parser_meta.l4_src_port: ternary;
            user_meta.parser_meta.l4_dst_port: ternary;
        }
        actions = {
            execute_netcachecoherenceengine_stage0_act0;
            execute_netcachecoherenceengine_stage0_act1;
            execute_netcachecoherenceengine_stage0_act2;
            execute_netcachecoherenceengine_stage0_act3;
            drop_netcachecoherenceengine_stage0;
            NoAction;
        }
        size = 2048;
        default_action = NoAction();
    }

    apply {
        netcachecoherenceengine_stage0_table.apply();
    }
}

