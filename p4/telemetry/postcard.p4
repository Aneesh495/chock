/*
 * Postcard Telemetry (INT-XD) Event Notification Pipeline (P4_16)
 *
 * Generates autonomous out-of-band telemetry postcards when instantaneous
 * queue depths cross configured microburst thresholds.
 */

#ifndef _CHOCK_TELEMETRY_POSTCARD_P4_
#define _CHOCK_TELEMETRY_POSTCARD_P4_

#include "../arch/chock_arch.p4"
#include "../core/types.p4"
#include "../core/unified_headers.p4"
#include "../core/metadata.p4"
#include "int_headers.p4"

control ChockPostcardTelemetry(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_egress_intrinsic_metadata_t eg_intr_md
) {
    ChockRegister<bit<32>>(1024, 0) postcard_seq_reg;

    action emit_postcard_report(bit<32> switch_id, bit<4> drop_reason) {
        hdr.int_postcard.setValid();
        hdr.int_postcard.version = 4#1;
        hdr.int_postcard.drop_reason = drop_reason;

        bit<32> seq = postcard_seq_reg.read(0);
        postcard_seq_reg.write(0, seq + 1);
        hdr.int_postcard.sequence_number = (bit<8>)seq;

        hdr.int_postcard.postcard_flags = 16#0001;
        hdr.int_postcard.switch_id = switch_id;
        hdr.int_postcard.ingress_port = user_meta.l2_meta.l2_egress_port;
        hdr.int_postcard.egress_port = eg_intr_md.egress_port;
        hdr.int_postcard.reserved = 14#0;
        hdr.int_postcard.queue_depth = eg_intr_md.queue_depth_packets;
        hdr.int_postcard.event_timestamp = eg_intr_md.egress_global_timestamp;
    }

    table postcard_trigger_table {
        key = {
            eg_intr_md.egress_port: exact;
        }
        actions = {
            emit_postcard_report;
            NoAction;
        }
        size = 256;
        default_action = NoAction();
    }

    apply {
        /*
         * Trigger postcard on high queue occupancy (> 1000 packets)
         */
        if (eg_intr_md.queue_depth_packets > 1000) {
            postcard_trigger_table.apply();
        }
    }
}


/*
 * Comprehensive Match-Action Processing Pipeline for PostcardEngine
 * Implements hardware TCAM, SRAM, and stateful ALU execution stages.
 */

control ChockPostcardEngineStage0(
    inout headers_t hdr,
    inout user_metadata_t user_meta,
    in chock_ingress_intrinsic_metadata_t ig_intr_md,
    inout chock_ingress_to_egress_metadata_t ig_to_eg_md
) {
    ChockRegister<bit<32>>(2048, 0) stage_state_reg;
    ChockCounter(2048, CounterType_t.PACKETS_AND_BYTES) stage_counter;
    ChockMeter(2048) stage_meter;

    action execute_postcardengine_stage0_act0(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_postcardengine_stage0_act1(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_postcardengine_stage0_act2(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action execute_postcardengine_stage0_act3(
        port_id_t  target_port,
        bit<16>    flow_metric,
        bit<8>     qos_class,
        mac_addr_t rewrite_mac
    ) {
        ig_to_eg_md.egress_port = target_port;
        ig_to_eg_md.traffic_class = qos_class[2:0];
        user_meta.l3_meta.route_metric = flow_metric;
        stage_counter.count((bit<32>)target_port);
        bit<32> prev_state = stage_state_reg.read((bit<32>)target_port);
        stage_state_reg.write((bit<32>)target_port, prev_state + 1);
    }

    action drop_postcardengine_stage0(bit<8> drop_code) {
        ig_to_eg_md.drop_flag = 1#1;
        ig_to_eg_md.decision = ForwardingDecision_t.FORWARD_DROP;
    }

    table postcardengine_stage0_table {
        key = {
            ig_intr_md.ingress_port:           exact;
            user_meta.l2_meta.ingress_vlan_id: ternary;
            hdr.ipv4.dst_addr:                 ternary;
            hdr.ipv4.src_addr:                 ternary;
            hdr.ipv4.protocol:                 ternary;
            user_meta.parser_meta.l4_src_port: ternary;
            user_meta.parser_meta.l4_dst_port: ternary;
        }
        actions = {
            execute_postcardengine_stage0_act0;
            execute_postcardengine_stage0_act1;
            execute_postcardengine_stage0_act2;
            execute_postcardengine_stage0_act3;
            drop_postcardengine_stage0;
            NoAction;
        }
        size = 2048;
        default_action = NoAction();
    }

    apply {
        postcardengine_stage0_table.apply();
    }
}

